# Copy to .env for local runs outside Docker Compose.
LINKFLOW_HTTP_ADDR=:8080
# 5433 on the host, because 5432 is usually taken by a local Postgres install.
LINKFLOW_DATABASE_URL=postgres://linkflow:linkflow@localhost:5433/linkflow?sslmode=disable
LINKFLOW_BASE_URL=http://localhost:8080
LINKFLOW_MAX_POOL_CONNS=25

# Click recording strategy.
#   batch = phase 2, bounded channel + batcher goroutine (default)
#   sync  = phase 1 baseline, insert on the redirect path
LINKFLOW_ANALYTICS_MODE=batch
LINKFLOW_ANALYTICS_BUFFER=10000
LINKFLOW_ANALYTICS_BATCH_SIZE=1000
LINKFLOW_ANALYTICS_FLUSH_INTERVAL=200ms

# Read path. Empty LINKFLOW_REDIS_ADDR disables the shared tier; 0 local items
# disables the in-process tier. Both are used to isolate what each tier is worth.
LINKFLOW_REDIS_ADDR=localhost:6379
LINKFLOW_REDIS_POOL_SIZE=50
LINKFLOW_LOCAL_CACHE_ITEMS=100000
LINKFLOW_CACHE_TTL=10m
LINKFLOW_NEGATIVE_CACHE_TTL=30s
LINKFLOW_SINGLEFLIGHT=true

# Host port bindings for the observability stack.
LINKFLOW_REDIS_PORT=6379
LINKFLOW_PROMETHEUS_PORT=9090
LINKFLOW_GRAFANA_PORT=3000

# Host port bindings used by docker compose.
LINKFLOW_PORT=8080
LINKFLOW_POSTGRES_PORT=5433

# Only read by the integration tests; unset means they skip.
# LINKFLOW_TEST_DATABASE_URL=postgres://linkflow:linkflow@localhost:5433/linkflow_test?sslmode=disable
